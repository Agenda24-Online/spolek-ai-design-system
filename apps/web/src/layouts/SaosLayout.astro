---
import { modules } from '../data/modules';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Spolek.ai Operating System' } = Astro.props;
const base = import.meta.env.BASE_URL;
const withBase = (href: string) => `${base}${href.replace(/^\//, '')}`;
---
<!doctype html>
<html lang="cs">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title} — SAOS</title>
  </head>
  <body>
    <div class="shell">
      <aside class="sidebar">
        <a class="brand" href={withBase('/')}>
          <span class="brand-mark">S</span>
          <span><strong>Spolek.ai</strong><small>Operating System</small></span>
        </a>
        <nav aria-label="Hlavní navigace">
          {modules.map((item) => (
            <a href={withBase(item.href)}>
              <span>{item.label}</span>
              {item.status === 'planned' && <small>plán</small>}
            </a>
          ))}
        </nav>
        <p class="release">SAOS 0.1 · M1</p>
      </aside>
      <div class="workspace">
        <header class="topbar">
          <span>Centrální systém značky a podnikání</span>
          <span class="state">schválený obsah</span>
        </header>
        <main><slot /></main>
      </div>
    </div>
  </body>
</html>
