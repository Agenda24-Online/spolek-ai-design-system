---
import { getEntry, render } from 'astro:content';
import SaosLayout from '../layouts/SaosLayout.astro';
import { modules } from '../data/modules';

const home = await getEntry('public', 'home');
if (!home) throw new Error('Chybí obsah saos-home.');
const { Content } = await render(home);
const active = modules.filter((item) => item.status === 'active').length;
---
<SaosLayout title={home.data.title}>
  <section class="hero">
    <p class="eyebrow">Pracovní centrum</p>
    <h1>{home.data.title}</h1>
    <div class="lead"><Content /></div>
    <div class="stats">
      <span><strong>{modules.length}</strong> modulů</span>
      <span><strong>{active}</strong> aktivních oblastí</span>
      <span><strong>1</strong> zdroj pravdy</span>
    </div>
  </section>

  <section aria-labelledby="modules-heading">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Struktura SAOS</p>
        <h2 id="modules-heading">Vše podstatné na jednom místě</h2>
      </div>
      <p>Obsah se bude doplňovat postupně. Modul označený „plán“ je připravený ve struktuře, ale zatím nemá schválený obsah.</p>
    </div>
    <div class="module-grid">
      {modules.map((item, index) => (
        <a class:list={['module-card', { planned: item.status === 'planned' }]} href={item.status === 'active' ? item.href : undefined} aria-disabled={item.status === 'planned'}>
          <span class="number">{String(index + 1).padStart(2, '0')}</span>
          <h3>{item.label}</h3>
          <p>{item.description}</p>
          <span class="module-state">{item.status === 'active' ? 'Otevřít' : 'Připraveno pro další etapu'}</span>
        </a>
      ))}
    </div>
  </section>
</SaosLayout>
