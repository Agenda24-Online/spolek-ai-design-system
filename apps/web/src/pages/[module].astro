---
import SaosLayout from '../layouts/SaosLayout.astro';
import { modules } from '../data/modules';

const copy: Record<string, { intro: string; sections: [string, string][] }> = {
  'design-system': { intro: 'Pravidla, tokeny a komponenty, díky kterým všechny digitální výstupy Spolek.ai vypadají a fungují konzistentně.', sections: [['Design tokeny','Barvy, typografie, mezery, rádiusy a stavy rozhraní jako společný technický jazyk.'],['Komponenty','Opakovatelná tlačítka, karty, formuláře, navigace a informační prvky.'],['Přístupnost','Kontrast, čitelnost, ovládání klávesnicí a srozumitelné stavy.'],['Implementace','Schválené vzory pro web, dokumenty, prezentace a další produkty.']] },
  'business-os': { intro: 'Řídicí vrstva podnikání: strategie, nabídka, cílové skupiny, cenotvorba, partnerství a měřitelné cíle.', sections: [['Strategie','Poslání, vize, priority a pravidla, podle kterých se vybírají projekty.'],['Nabídka','Služby, produkty, balíčky a jasná hodnota pro jednotlivé cílové skupiny.'],['Obchodní model','Příjmové větve, náklady, distribuční kanály a partnerská spolupráce.'],['Měření','Cíle, ukazatele, výsledky a pravidelná aktualizace priorit.']] },
  'ai-team': { intro: 'Přehled AI rolí, jejich kompetencí, vstupů, výstupů, omezení a lidské odpovědnosti.', sections: [['Role','Každý AI člen má jasný účel, působnost a hranice rozhodování.'],['Prompty','Schválená zadání navázaná na skutečná data a pravidla značky.'],['Kontrola kvality','Fakta, soulad se strategií, ochrana dat a finální lidské schválení.'],['Spolupráce','Předávání práce mezi lidmi, agenty a automatizacemi bez ztráty kontextu.']] },
  'workflow': { intro: 'Opakovatelné pracovní postupy od zadání přes tvorbu a kontrolu až po publikaci a vyhodnocení.', sections: [['Zadání','Cíl, publikum, vstupy, omezení a vlastník výstupu.'],['Výroba','Konkrétní kroky, odpovědnosti, nástroje a kontrolní body.'],['Schválení','Povinné kontroly před použitím nebo zveřejněním.'],['Zlepšování','Výsledky a zkušenosti se vracejí zpět do systému.']] },
  'marketing': { intro: 'Marketingová strategie, obsahové pilíře, kampaně, distribuční kanály a pravidla vyhodnocování.', sections: [['Pozice značky','Jak Spolek.ai mluví o své hodnotě a čím se odlišuje.'],['Obsah','Témata, formáty, publikační rytmus a schvalovací pravidla.'],['Kampaně','Cíl, publikum, nabídka, kanál, rozpočet a měření.'],['Distribuce','Web, sociální sítě, e-mail, partneři a živé akce.']] },
  'knowledge-base': { intro: 'Dohledatelná znalostní báze pro návody, výzkum, zkušenosti, zdroje a ověřené odpovědi.', sections: [['Návody','Praktické postupy pro opakované úkoly a řešení problémů.'],['Výzkum','Zdroje, zjištění, ověření a datum platnosti informací.'],['Know-how','Zkušenosti z projektů převedené do znovu použitelných pravidel.'],['Vazby','Propojení znalostí s rozhodnutími, workflow a konkrétními aktivy.']] },
  'decision-log': { intro: 'Auditovatelný záznam důležitých rozhodnutí, jejich důvodů, vlastníků a dopadů.', sections: [['Rozhodnutí','Jednoznačný popis toho, co bylo schváleno.'],['Důvody','Kontext, zvažované alternativy a rozhodovací kritéria.'],['Dopady','Koho a které části systému rozhodnutí mění.'],['Revize','Datum kontroly a podmínky, za kterých se má rozhodnutí znovu otevřít.']] },
  'future-ideas': { intro: 'Řízený zásobník nápadů, příležitostí a experimentů, které ještě nejsou schváleným plánem.', sections: [['Zachycení','Nápad se uloží bez toho, aby se automaticky stal závazkem.'],['Posouzení','Přínos, náročnost, rizika, soulad se strategií a vlastník.'],['Experiment','Nejmenší ověřitelný test a jasné kritérium úspěchu.'],['Rozhodnutí','Pokračovat, odložit, upravit nebo ukončit.']] },
  'asset-library': { intro: 'Centrální katalog log, fotografií, ilustrací, šablon, dokumentů a dalších schválených podkladů.', sections: [['Loga','Originální varianty, ochranná zóna, minimální velikost a zakázané úpravy.'],['Obrazové podklady','Fotografie, ilustrace, avatary a pravidla jejich použití.'],['Šablony','Prezentace, dokumenty, příspěvky, bannery a pracovní soubory.'],['Metadata','Verze, vlastník, licence, stav schválení a vazba na projekt.']] }
};

export function getStaticPaths() {
  return modules.filter((item) => !['project','brand'].includes(item.id)).map((item) => ({
    params: { module: item.id },
    props: { item }
  }));
}

const { item } = Astro.props;
const page = copy[item.id];
---
<SaosLayout title={item.label} description={item.description}>
  <section class="module-hero">
    <p class="eyebrow">Spolek.ai Operating System</p>
    <h1>{item.label}</h1>
    <p class="module-intro">{page.intro}</p>
  </section>
  <section class="story-section">
    <p class="eyebrow">Obsah modulu</p>
    <div class="content-grid">
      {page.sections.map(([title,text]) => <article class="content-card"><h2>{title}</h2><p>{text}</p></article>)}
    </div>
  </section>
</SaosLayout>
