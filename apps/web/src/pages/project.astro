---
import SaosLayout from '../layouts/SaosLayout.astro';

const pillars = [
  { n: '01', title: 'Značka', text: 'Jednotná identita, hodnoty, jazyk, vizuální pravidla a důvěryhodná prezentace.' },
  { n: '02', title: 'Byznys', text: 'Nabídka, cílové skupiny, obchodní model, cenotvorba, partnerství a růst.' },
  { n: '03', title: 'Znalosti', text: 'Jeden dohledatelný zdroj pravdy pro rozhodnutí, návody, výzkum a zkušenosti.' },
  { n: '04', title: 'AI tým', text: 'Definované role, prompty, odpovědnosti a kontrola kvality lidským vlastníkem.' },
  { n: '05', title: 'Výroba', text: 'Opakovatelné workflow od zadání přes kontrolu až po publikovaný výstup.' },
  { n: '06', title: 'Aktiva', text: 'Loga, šablony, grafika, dokumenty, komponenty a jejich řízené verze.' }
];

const audiences = [
  ['Zakladatel a vedení', 'Řídí směr, priority, pravidla a schvaluje zásadní rozhodnutí.'],
  ['Interní a externí tým', 'Pracuje podle stejných standardů bez ztráty kontextu.'],
  ['AI agenti a automatizace', 'Čerpají z ověřených dat, rolí a schválených pracovních postupů.'],
  ['Partneři a klienti', 'Dostávají konzistentní výstupy, služby a prezentaci projektu.']
];

const revenue = [
  ['Členství a partnerství', 'Pravidelný příjem za přístup, spolupráci a společné aktivity.'],
  ['Školení a workshopy', 'Praktické vzdělávání firem, týmů i odborné veřejnosti.'],
  ['Konzultace a implementace', 'Audit, strategie, zavedení AI a pracovních systémů na míru.'],
  ['Digitální produkty', 'Manuály, šablony, prompty, nástroje, licence a oborové balíčky.'],
  ['Projekty a granty', 'Výzkumné, komunitní a vzdělávací projekty s měřitelným dopadem.'],
  ['Partnerské tržiště', 'Provize nebo poplatky za ověřené služby a doporučená řešení.']
];
---
<SaosLayout title="O projektu Spolek.ai Operating System" description="Komplexní představení projektu SAOS, jeho fungování, modulů a obchodního modelu.">
  <section class="project-hero">
    <div>
      <p class="eyebrow">Představení projektu · SAOS 1.0</p>
      <h1>Operační systém pro značku, znalosti a podnikání Spolek.ai</h1>
      <p class="project-lead">Spolek.ai Operating System není běžný web ani statický brand manuál. Je to živé řídicí prostředí, které propojuje identitu značky, obchodní strategii, firemní know-how, AI role, pracovní postupy a digitální aktiva do jednoho verzovaného systému.</p>
    </div>
    <div class="project-thesis">
      <span>Hlavní princip</span>
      <strong>Jednou rozhodnout.<br />Jednou uložit.<br />Všude správně použít.</strong>
      <p>Každý schválený údaj má jedno místo, vlastníka, verzi a jasný způsob použití.</p>
    </div>
  </section>

  <section class="story-section">
    <div class="story-heading">
      <p class="eyebrow">Proč projekt vzniká</p>
      <h2>Z chaosu souborů vzniká řiditelný systém</h2>
    </div>
    <div class="problem-grid">
      <article><span>Bez SAOS</span><h3>Roztříštěné informace</h3><p>Barvy, texty, strategie, prompty a rozhodnutí leží v různých chatech, složkách a hlavách lidí. Starší verze se zaměňují za platné.</p></article>
      <article><span>Se SAOS</span><h3>Jeden zdroj pravdy</h3><p>Schválený obsah je dohledatelný, propojený a připravený pro lidi, AI i automatizované nástroje.</p></article>
      <article><span>Dopad</span><h3>Rychlejší a přesnější práce</h3><p>Méně opakovaného vysvětlování, méně chyb, rychlejší zaučení spolupracovníků a konzistentnější výstupy.</p></article>
    </div>
  </section>

  <section class="story-section">
    <div class="story-heading">
      <p class="eyebrow">Charakter projektu</p>
      <h2>Šest vrstev jednoho ekosystému</h2>
      <p>SAOS je modulární: jednotlivé části lze rozvíjet postupně, ale všechny používají společná pravidla, metadata a historii změn.</p>
    </div>
    <div class="pillar-grid">
      {pillars.map((item) => <article><span>{item.n}</span><h3>{item.title}</h3><p>{item.text}</p></article>)}
    </div>
  </section>

  <section class="story-section infographic-section" aria-labelledby="map-title">
    <div class="story-heading">
      <p class="eyebrow">Komplexní infografika projektu</p>
      <h2 id="map-title">Jak SAOS funguje od strategie až k příjmům</h2>
      <p>Mapa ukazuje celý tok: řízení projektu stanoví pravidla, systém spravuje znalosti, AI a lidé je převádějí do procesů, procesy tvoří výstupy a ty vytvářejí hodnotu pro trh.</p>
    </div>

    <div class="ecosystem-map" role="img" aria-label="Infografika toku SAOS od vedení přes jádro systému a výrobu až k trhu a příjmům">
      <div class="map-stage stage-governance">
        <span class="stage-label">01 · Řízení</span>
        <div class="node primary"><b>Vize a poslání</b><small>Proč Spolek.ai existuje</small></div>
        <div class="node"><b>Vedení projektu</b><small>Priority, vlastníci, schválení</small></div>
        <div class="node"><b>Decision Log</b><small>Důvody a historie rozhodnutí</small></div>
      </div>
      <div class="map-arrow"><span>pravidla a priority</span></div>
      <div class="map-stage stage-core">
        <span class="stage-label">02 · Jádro SAOS</span>
        <div class="core-ring">
          <div class="core-title"><b>SAOS</b><small>jeden zdroj pravdy</small></div>
          <div class="orbit orbit-a">Brand Manual</div>
          <div class="orbit orbit-b">Business OS</div>
          <div class="orbit orbit-c">Knowledge Base</div>
          <div class="orbit orbit-d">Design System</div>
          <div class="orbit orbit-e">Asset Library</div>
          <div class="orbit orbit-f">AI Team</div>
        </div>
      </div>
      <div class="map-arrow"><span>ověřený kontext</span></div>
      <div class="map-stage stage-production">
        <span class="stage-label">03 · Výroba</span>
        <div class="node primary"><b>Zadání</b><small>Cíl, publikum, omezení</small></div>
        <div class="node"><b>Lidé + AI role</b><small>Tvorba, analýza, kontrola</small></div>
        <div class="node"><b>Workflow</b><small>Postup, checkpointy, schválení</small></div>
        <div class="node"><b>Výstup</b><small>Obsah, služba, nástroj, projekt</small></div>
      </div>
      <div class="map-arrow"><span>hodnota pro uživatele</span></div>
      <div class="map-stage stage-market">
        <span class="stage-label">04 · Trh a dopad</span>
        <div class="node"><b>Firmy a instituce</b><small>Implementace a vzdělávání</small></div>
        <div class="node"><b>Členové a komunita</b><small>Sdílení know-how a spolupráce</small></div>
        <div class="node"><b>Partneři</b><small>Společné projekty a distribuce</small></div>
        <div class="node primary"><b>Příjmy + dopad</b><small>Udržitelný růst projektu</small></div>
      </div>
      <div class="feedback-loop"><span>Zpětná vazba, data a zkušenosti se vracejí do Knowledge Base a dalších rozhodnutí</span></div>
    </div>
  </section>

  <section class="story-section split-section">
    <div>
      <p class="eyebrow">Pro koho systém je</p>
      <h2>Jeden systém, různé úrovně přístupu</h2>
    </div>
    <div class="audience-list">
      {audiences.map(([title, text], i) => <article><span>0{i + 1}</span><div><h3>{title}</h3><p>{text}</p></div></article>)}
    </div>
  </section>

  <section class="story-section">
    <div class="story-heading">
      <p class="eyebrow">Obchodní fungování</p>
      <h2>SAOS podporuje více příjmových větví</h2>
      <p>Systém sám není obchodní model. Je infrastrukturou, která drží nabídku konzistentní, zrychluje výrobu a umožňuje produkty i služby opakovat, škálovat a licencovat.</p>
    </div>
    <div class="revenue-grid">
      {revenue.map(([title, text], i) => <article><span>{String(i + 1).padStart(2, '0')}</span><h3>{title}</h3><p>{text}</p></article>)}
    </div>
  </section>

  <section class="story-section operating-cycle">
    <div class="story-heading">
      <p class="eyebrow">Provozní cyklus</p>
      <h2>Každý nový obsah projde řízenou cestou</h2>
    </div>
    <ol class="cycle">
      <li><b>Zachytit</b><span>Nápad, potřeba, poznatek nebo obchodní příležitost.</span></li>
      <li><b>Posoudit</b><span>Význam, rizika, duplicity, vlastník a cílové publikum.</span></li>
      <li><b>Vytvořit</b><span>Obsah nebo řešení podle pravidel značky a workflow.</span></li>
      <li><b>Ověřit</b><span>Fakta, kvalita, soulad se strategií a ochrana interních dat.</span></li>
      <li><b>Schválit</b><span>Vlastník rozhodne a systém uloží verzi i důvod změny.</span></li>
      <li><b>Použít a měřit</b><span>Výstup jde do praxe a výsledky se vracejí do systému.</span></li>
    </ol>
  </section>

  <section class="project-summary">
    <p class="eyebrow">Výsledná hodnota</p>
    <h2>SAOS proměňuje know-how Spolek.ai v dlouhodobě použitelné aktivum.</h2>
    <p>Není závislý na jednom člověku, jednom chatu ani jednom dodavateli. Uchovává kontext, podporuje kontrolovanou spolupráci a umožňuje představit projekt partnerům, členům, zákazníkům i investorům jako promyšlený a škálovatelný celek.</p>
  </section>
</SaosLayout>
